# BEKRI local-first model gateway (Ollama OpenAI-compatible API).
# Install Ollama, then: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b
# Optional custom OpenAI-compatible local endpoint. Leave empty for Ollama.
LLM_BASE_URL=
LLM_API_KEY=

# Optional vision model. Choose an Ollama vision model such as llava or qwen2.5vl.
VISION_MODEL=qwen2.5vl:3b

# Local privacy defaults: no hosted AI provider is configured.
MOCK=0
ACCESS_TOKEN=
PORT=8787

# Personal profile (stored locally in server/data)
USER_NAME=صديقي
USER_ABOUT=

# Speech: browser speech is the offline fallback; cloud voice providers remain disabled unless configured.
TTS_MODEL=browser
TTS_VOICE=
TTS_RATE=0.98
TTS_SPEED=1.0
STT_MODEL=whisper-local

# Optional internet-connected features. Leave keys empty to keep them unavailable.
YOUTUBE_API_KEY=
YOUTUBE_CHANNELS=
YOUTUBE_OWN_CHANNEL=
YOUTUBE_OWN_ALIASES=
YOUTUBE_OWN_NAME=
YOUTUBE_FAVORITES=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Local camera permission is controlled by the app and browser. Do not expose the server publicly without authentication.
CAMERA_ENABLED=1

# Weather location (weather lookup requires internet)
WEATHER_CITY=Gaziantep
WEATHER_LAT=37.0662
WEATHER_LON=37.3833

# Optional smart-home bridge (local Home Assistant)
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HA_ENTITIES=salon_isik=light.salon,calisma_isik=light.calisma_odasi,turk_kahve=switch.turk_kahve_priz,filtre_kahve=switch.filtre_kahve_priz

# Optional WebRTC TURN relay; camera stream can use STUN on local networks.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
